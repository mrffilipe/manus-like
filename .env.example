# Postgres (local dev — Docker Compose overrides host to `postgres`)
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent_secret
POSTGRES_DB=agent_db
DATABASE_URL=postgresql+asyncpg://agent:agent_secret@localhost:5432/agent_db

# Redis (internal Docker network only — no host port exposed)
REDIS_URL=redis://redis:6379/0

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=agent_memory

# LLM (Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Tool services
BROWSER_SERVICE_URL=http://browser-service:3001
SEARCH_SERVICE_URL=http://search-service:8080

# Agent
LOG_LEVEL=INFO
MAX_GRAPH_ITERATIONS=10
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ATTACHMENTS_DIR=data/attachments

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000
VITE_API_TIMEOUT_MS=30000
